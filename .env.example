# Copy to .env in this folder and edit. Nothing here is required to try the app.

# Where photos, audio, the sqlite db and the CA live.
PUJA_DATA_DIR=data

# The workbook the app appends to. Point this at your live file when you are ready.
PUJA_LEDGER_PATH=data/ledger/Durga Puja 2026.xlsx
# the real sheet name is "CASH " with a trailing space; a plain CASH works too
PUJA_LEDGER_SHEET=CASH

# Listeners. The phone needs the https one.
PUJA_ADDR=0.0.0.0:8080
PUJA_TLS_ADDR=0.0.0.0:8443
PUJA_TLS=on

# Optional shared PIN for writes (header x-pin).
# PUJA_PIN=4821

# none | openai | fake
PUJA_VISION_PROVIDER=none
PUJA_VISION_BASE_URL=https://api.openai.com/v1
# PUJA_VISION_API_KEY=sk-...
PUJA_VISION_MODEL=gpt-4o-mini

# Speech can be a different server than vision. Leave the base URL out to reuse
# PUJA_VISION_BASE_URL. A model on this machine (localhost/192.168./10.) needs no key.
# PUJA_STT_BASE_URL=http://127.0.0.1:8081/v1
# PUJA_STT_API_KEY=...
# PUJA_STT_MODEL=whisper-1
# Blank = let Whisper detect the language. Do not set "hi": it answers in
# Devanagari, which the number parser cannot read.
# PUJA_STT_LANGUAGE=en

# Where the built PWA lives.
PUJA_APP_DIR=app/dist

# ---------------------------------------------------------------- local models
# The whole point of this desk is that nothing leaves the laptop. With these
# five lines and scripts/models.sh (started by dev.sh) there is no cloud account
# and no API key anywhere.
#
# PUJA_VISION_PROVIDER=openai
# PUJA_VISION_BASE_URL=http://127.0.0.1:11434/v1
# PUJA_VISION_MODEL=gemma3:4b
# PUJA_STT_BASE_URL=http://127.0.0.1:8081/v1
# PUJA_STT_MODEL=whisper-1
#
# How long the vision model stays loaded with nothing to read. It is 2.9 GB of
# VRAM and ~1.1 GB of RAM, so on a 15 GB laptop let it go when the desk is quiet.
# PUJA_KEEP_ALIVE=15m
#
# "off" stops dev.sh from starting the models (for a cloud provider instead).
# PUJA_MODELS=on
